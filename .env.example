# Django
DJANGO_DEBUG=false
DJANGO_SERVE_STATIC=true
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=django.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://django.example.com

# CORS
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_COOKIE_DOMAIN=.example.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=false
CSRF_COOKIE_SAMESITE=Lax

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=eightfeet

# Redis / Channels
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DATABASE=0
CHANNEL_REDIS_ADDRESS=redis:6379

# MinIO
S3_SECRET_ID=CHANGE_ME_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_ADDRESS=minio:9000
S3_BUCKET_REPORTS=eightfeet-reports
S3_USE_SSL=false

# Runtime
STATIC_ROOT=/var/www/8feet/staticfiles
LOG_DIR=/var/log/8feet
LOG_LEVEL=INFO

# Security headers
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY

# Research / efeet model
MODEL_NAME=glm-5.1
MODEL_API_KEY=your-api-key
MODEL_BASE_URL=https://api.modelarts-maas.com/v2

# Optional: custom sandbox root for research runs
RESEARCH_SANDBOX_BASE_DIR=
